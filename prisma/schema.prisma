generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  UNPAID
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
  FINANCE
  VIEWER
  SUPPORT
  MARKETING
  API_CLIENT
}

enum FeatureKey {
  CREATE_EVENTS
  SELL_TICKETS
  ANALYTICS
  CUSTOM_BRANDING
  TEAM_MEMBERS
  API_ACCESS
  NO_PLATFORM_FEE
  IMPORT_DB_USERS
}

enum EventStatus {
  DRAFT
  REVIEW
  PUBLISHED
  SALES_OPEN
  SALES_PAUSED
  SALES_CLOSED
  LIVE
  COMPLETED
  CANCELLED
  ARCHIVED
  BLOCKED
  UNPUBLISHED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum Currency {
  PLN
  USD
  EUR
  UAH
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum Country {
  COUNTRY_PL
  COUNTRY_US
  COUNTRY_UK
  COUNTRY_UA
  COUNTRY_DE
  COUNTRY_FR
  COUNTRY_IT
  COUNTRY_ES
  COUNTRY_CA
  COUNTRY_AU
  COUNTRY_NZ
}

enum VatStatus {
  ACTIVE
  EXEMPT
  UNREGISTERED
  CANCELLED
}

enum EmployeeCountRange {
  MICRO // < 10 osób
  SMALL // 10–49
  MEDIUM // 50–249
  LARGE // 250+
}

enum AddressType {
  REGISTERED // siedziba / adres rejestrowy
  BILLING // do faktur
  SHIPPING // do wysyłek
  BRANCH // oddział / filia
  CORRESPONDENCE // do korespondencji
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SectionType {
  TEXT
  IMAGE
  FAQ
  VIDEO
  SPEAKERS
  CUSTOM
}

// ─────────────────────────────────────────────
// AUTH MODELS (better-auth compatible)
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String   @map("name")
  surname       String?  @map("surname")
  email         String   @map("email")
  emailVerified Boolean  @default(false) @map("email_verified")
  role          UserRole @default(USER) @map("user_role")
  image         String?  @map("image")

  banned     Boolean?  @default(false) @map("banned")
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions Session[]
  accounts Account[]

  // Членство в организациях (через join-таблицу — единственная связь)
  organizationMembers OrganizationMember[]

  // Заказы пользователя
  orders   Order[]
  payments Payment[]

  @@unique([email])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────
// INVITATION
// ─────────────────────────────────────────────

model Invitation {
  id String @id @default(uuid())

  email String @unique
  token String @unique

  name    String
  surname String

  isAccepted Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("invitations")
}

// ─────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────

model Organization {
  id   String @id @default(uuid())
  slug String @unique

  // ── polska identyfikacja firmy ───────────────────────────────────────
  nip   String? @unique // 10 cyfr, bez myślników, unikalne
  regon String? @unique // 9 lub 14 cyfr
  krs   String? @unique // 10 cyfr – tylko spółki rejestrowane w KRS

  // ── forma prawna (kluczowe przy fakturach, KSeF, umowach B2B) ─────────
  legalForm     String? // "osoba fizyczna", "sp. z o.o.", "S.A.", "sp.k.", "sp.j.", "stowarzyszenie"...
  legalFormCode String? // np. kod GUS / REGON: "019", "091", "092"...

  // ── status VAT i KSeF (obowiązkowy B2B od 2026/2027) ──────────────────
  vatStatus   VatStatus? @default(ACTIVE)
  ksefEnabled Boolean    @default(false) // czy wystawia faktury przez KSeF
  vatId       String? // "PL" + NIP (czasami osobno)

  // ── pozostałe przydatne pola ─────────────────────────────────────────
  website String?
  phone   String?
  email   String? // oficjalny e-mail firmy

  // statystyki / compliance
  employeeCountRange EmployeeCountRange? // mikro / małe / średnie / duże
  industry           String? // branża / PKD opisowo
  mainPkdCode        String? // np. "62.01.Z"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // subscriptions         Subscriptions[]
  events                    Event[]
  organizationMembers       OrganizationMember[]
  organizationAddresses     OrganizationAddress[]
  // usages              Usages[]
  organizationSubscriptions OrganizationSubscription[]
  organizationFeatures      OrganizationFeature[]

  @@map("organizations")
}

model OrganizationAddress {
  id   String      @id @default(uuid())
  type AddressType // BILLING, SHIPPING, REGISTERED, BRANCH...

  // ── adres siedziby (bardzo często wymagany w fakturach, KSeF, ePUAP) ──
  street          String
  buildingNumber  String
  apartmentNumber String?
  zipCode         String
  city            String
  voivodeship     String? // województwo – przydatne w raportach
  country         Country @default(COUNTRY_PL)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // ewentualnie userId jeśli adres prywatny użytkownika

  @@map("addresses")
}

model OrganizationMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId         String @map("user_id")
  organizationId String @map("organization_id")

  memberRole    MemberRole   @default(OWNER) @map("member_role")
  user          User         @relation(fields: [userId], references: [id])
  organizations Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId], name: "user_organization_unique")
  @@index([userId], name: "idx_organization_members_user_id")
  @@index([organizationId], name: "idx_organization_members_organization_id")
  @@map("organization_members")
}

// ─────────────────────────────────────────────
// EVENT CATEGORY
// ─────────────────────────────────────────────

model EventCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name String  @unique @map("name") // напр. "Концерт", "Конференция"
  slug String  @unique @map("slug") // напр. "concert", "conference"
  icon String? @map("icon") // эмодзи или имя иконки

  // Иерархия: подкатегории (напр. Музыка → Рок, Джаз)
  parentId String?         @map("parent_id")
  parent   EventCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children EventCategory[] @relation("CategoryHierarchy")

  events EventCategoryOnEvent[]

  @@index([parentId], name: "idx_event_categories_parent_id")
  @@map("event_categories")
}

/// Join-таблица для many-to-many: Event ↔ EventCategory
model EventCategoryOnEvent {
  eventId    String @map("event_id")
  categoryId String @map("category_id")

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@index([categoryId], name: "idx_event_category_on_event_category_id")
  @@map("event_categories_on_events")
}

// ─────────────────────────────────────────────
// EVENT
// ─────────────────────────────────────────────

model Event {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title       String      @map("title")
  description String?     @map("description")
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime?   @map("ends_at")
  status      EventStatus @default(DRAFT) @map("status")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  tickets          Ticket[]
  orders           Order[]
  categories       EventCategoryOnEvent[]
  eventSections    EventSection[]
  eventAgendaItems EventAgendaItem[]

  @@index([organizationId], name: "idx_events_organization_id")
  @@index([status], name: "idx_events_status")
  @@map("events")
}

// ─────────────────────────────────────────────
// TICKET
// ─────────────────────────────────────────────

model Ticket {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String   @map("name")
  /// Цена в минимальных единицах валюты (гроши, центы)
  price     Int      @map("price")
  /// Общее количество билетов (null = безлимитно)
  quantity  Int?     @map("quantity")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events     Event       @relation(fields: [eventId], references: [id])
  orderItems OrderItem[]

  // sold считается через агрегацию OrderItem — не хранится денормализованно

  @@index([eventId], name: "idx_tickets_event_id")
  @@map("tickets")
}

// ─────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────

model Order {
  id      String @id @default(uuid())
  eventId String @map("event_id")

  /// Пользователь (null — гостевой заказ)
  userId String? @map("user_id")
  /// Email всегда сохраняем (для гостей и зарегистрированных)
  email  String  @map("email")

  status   OrderStatus @default(PENDING) @map("status")
  /// Итоговая сумма в минимальных единицах валюты
  total    Int         @default(0) @map("total")
  currency Currency    @default(PLN) @map("currency")

  // Данные покупателя (денормализованы для истории)
  buyerName    String? @map("buyer_name")
  buyerSurname String? @map("buyer_surname")
  buyerPhone   String? @map("buyer_phone")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events     Event       @relation(fields: [eventId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  payments   Payment[]
  orderItems OrderItem[]

  @@index([eventId], name: "idx_orders_event_id")
  @@index([userId], name: "idx_orders_user_id")
  @@index([status], name: "idx_orders_status")
  @@map("orders")
}

// ─────────────────────────────────────────────
// ORDER ITEM
// ─────────────────────────────────────────────

model OrderItem {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  ticketId String @map("ticket_id")

  quantity Int @default(1) @map("quantity")
  /// Цена на момент покупки (snapshot)
  price    Int @default(0) @map("price")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // deletedAt убран — позиции заказа не удаляются мягко,
  // отмена происходит через OrderStatus

  orders  Order  @relation(fields: [orderId], references: [id])
  tickets Ticket @relation(fields: [ticketId], references: [id])

  participants Participant[]

  @@index([ticketId], name: "idx_order_item_ticket_id")
  @@index([orderId], name: "idx_order_item_order_id")
  @@map("order_items")
}

// ─────────────────────────────────────────────
// Participant (кому принадлежит билет - участник)
// ─────────────────────────────────────────────

model Participant {
  id          String @id @default(uuid())
  orderItemId String @map("order_item_id")

  name    String  @map("name")
  surname String  @map("surname")
  email   String? @map("email")
  phone   String? @map("phone")

  /// Уникальный код для QR / чекина
  checkInCode String    @unique @default(uuid()) @map("check_in_code")
  checkedInAt DateTime? @map("checked_in_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId], name: "idx_attendees_order_item_id")
  @@index([checkInCode], name: "idx_attendees_check_in_code")
  @@map("participants")
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id      String  @id @default(uuid())
  /// Пользователь может быть null (гостевой заказ)
  userId  String? @map("user_id")
  orderId String  @map("order_id")

  provider          String?       @map("provider")
  providerPaymentId String?       @unique @map("provider_payment_id")
  /// Сумма в минимальных единицах валюты
  amount            Int           @default(0)
  currency          Currency      @default(PLN)
  status            PaymentStatus @default(CREATED) @map("status")

  orders Order @relation(fields: [orderId], references: [id])
  user   User? @relation(fields: [userId], references: [id])

  refunds Refund[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId], name: "idx_payments_order_id")
  @@index([status], name: "idx_payments_status")
  @@index([userId], name: "idx_payments_user_id")
  @@map("payments")
}

// ─────────────────────────────────────────────
// REFUND
// ─────────────────────────────────────────────

model Refund {
  id        String @id @default(uuid())
  paymentId String @map("payment_id")

  /// Сумма возврата в минимальных единицах валюты
  amount   Int          @map("amount")
  currency Currency     @default(PLN)
  reason   String?      @map("reason")
  status   RefundStatus @default(PENDING) @map("status")

  providerRefundId String? @unique @map("provider_refund_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId], name: "idx_refunds_payment_id")
  @@map("refunds")
}

// ─────────────────────────────────────────────
// BILLING — Тарифы и функции
// ─────────────────────────────────────────────

/// Тариф (Starter, Pro, Business и т.д.)
model Plan {
  id          String  @id @default(uuid())
  name        String  @unique @map("name") // "Starter", "Pro", "Business"
  slug        String  @unique @map("slug") // "starter", "pro", "business"
  description String? @map("description")
  isActive    Boolean @default(true) @map("is_active") // можно скрыть устаревший тариф

  /// Цена в минимальных единицах валюты
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly") // обычно дешевле чем 12 * monthly
  currency     Currency @default(PLN)

  /// ID продукта в Lemon Squeezy
  lsProductId      String? @map("ls_product_id")
  lsVariantMonthly String? @map("ls_variant_monthly") // variant для monthly
  lsVariantYearly  String? @map("ls_variant_yearly") // variant для yearly

  /// Лимиты включённые в тариф
  maxEvents      Int? @map("max_events") // null = безлимитно
  maxTeamMembers Int? @map("max_team_members")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions OrganizationSubscription[]

  @@map("plans")
}

/// Функции включённые в тариф
model PlanFeature {
  planId    String @map("plan_id")
  featureId String @map("feature_id")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

/// Отдельная функция которую можно купить à la carte
model Feature {
  id          String     @id @default(uuid())
  featureKey  FeatureKey @unique @map("feature_key")
  name        String     @map("name")
  description String?    @map("description")

  /// Цена разовой покупки (дороже чем в тарифе)
  price    Int      @map("price")
  currency Currency @default(PLN)

  /// ID продукта в Lemon Squeezy (one-time purchase)
  lsProductId String? @map("ls_product_id")
  lsVariantId String? @map("ls_variant_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  planFeatures         PlanFeature[]
  organizationFeatures OrganizationFeature[]

  @@map("features")
}

/// Подписка организации на тариф
model OrganizationSubscription {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  planId         String @map("plan_id")

  status   SubscriptionStatus @default(ACTIVE) @map("status")
  interval PlanInterval       @default(MONTHLY) @map("interval")

  /// Даты действия подписки
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  cancelledAt        DateTime? @map("cancelled_at")

  /// Данные из Lemon Squeezy
  lsSubscriptionId String? @unique @map("ls_subscription_id")
  lsCustomerId     String? @map("ls_customer_id")
  lsOrderId        String? @map("ls_order_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId], name: "idx_org_subscriptions_org_id")
  @@index([status], name: "idx_org_subscriptions_status")
  @@map("organization_subscriptions")
}

/// Разово купленная функция для организации (à la carte)
model OrganizationFeature {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  featureId      String @map("feature_id")

  /// До когда действует (null = бессрочно)
  expiresAt DateTime? @map("expires_at")

  /// Данные из Lemon Squeezy
  lsOrderId     String? @map("ls_order_id")
  lsOrderItemId String? @map("ls_order_item_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  feature      Feature      @relation(fields: [featureId], references: [id])

  @@unique([organizationId, featureId], name: "org_feature_unique")
  @@index([organizationId], name: "idx_org_features_org_id")
  @@map("organization_features")
}

// ─────────────────────────────────────────────
// EVENT SECTIONS & AGENDA
// ─────────────────────────────────────────────

/// Кастомные секции описания мероприятия
model EventSection {
  id        String      @id @default(uuid())
  eventId   String      @map("event_id")
  type      SectionType @map("type")
  title     String?     @map("title")
  /// Текст / markdown / URL — зависит от типа секции
  content   String?     @map("content")
  /// Порядок отображения
  order     Int         @map("order")
  isVisible Boolean     @default(true) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], name: "idx_event_sections_event_id")
  @@map("event_sections")
}

/// Расписание мероприятия (agenda)
model EventAgendaItem {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  title       String    @map("title")
  description String?   @map("description")
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  /// Зал / сцена если мероприятие многопоточное
  location    String?   @map("location")
  speakerName String?   @map("speaker_name")
  /// Порядок отображения
  order       Int       @map("order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], name: "idx_event_agenda_event_id")
  @@map("event_agenda_items")
}
